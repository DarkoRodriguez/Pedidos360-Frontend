# ===================================================
# Variables de Configuración para Frontend (Angular)
# Ubicación del archivo de configuración: src/environments/environment.development.ts
# ===================================================

# 1. Tenant ID de Azure / Microsoft Entra ID
# azure.tenantId = "TU_TENANT_ID"

# 2. Client ID de la App Registration en Azure
# azure.clientId = "TU_CLIENT_ID"

# 3. Scope de acceso al Backend
# azure.scope = "api://TU_CLIENT_ID/access_as_user"

# 4. URL del Backend Spring Boot
# apiUrl = "http://localhost:8080/api"

# 5. URI de redirección registrada en Azure (SPA redirect URI)
# azure.redirectUri = "http://localhost:4200/"
